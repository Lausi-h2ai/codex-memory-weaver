# Environment variables for HippocampAI MCP server

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
HIPPOCAMPAI_API_BASE_URL=http://localhost:8000

# Legacy compatibility aliases (optional):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional runtime settings
# HIPPOCAMPAI_COLLECTION=memories
# LOG_LEVEL=INFO

# Example profile: llama.cpp via OpenAI-compatible llama-server
# Start server:
#   llama-server -hf ggml-org/gemma-3-1b-it-GGUF
# MCP config:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=gemma-3-1b-it
